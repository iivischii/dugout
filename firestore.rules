rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function ownsCareer(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    match /careers/{uid} {
      allow read: if ownsCareer(uid);
      allow create: if ownsCareer(uid)
        && request.resource.data.keys().hasOnly(['managerName'])
        && request.resource.data.managerName is string
        && request.resource.data.managerName.size() > 0
        && request.resource.data.managerName.size() <= 60;
      // Manager identity is established once, not edited from the profile.
      allow update, delete: if false;
      match /matches/{matchId} {
        allow read: if ownsCareer(uid);
        allow create: if ownsCareer(uid)
          && exists(/databases/$(database)/documents/careers/$(uid))
          && request.resource.data.id == matchId
          && request.resource.data.goalsFor is int
          && request.resource.data.goalsFor >= 0
          && request.resource.data.goalsAgainst is int
          && request.resource.data.goalsAgainst >= 0
          && request.resource.data.result in ['W', 'D', 'L']
          && request.resource.data.events is list
          && request.resource.data.decisions is list;
        // An identical retry is harmless; completed results cannot be rewritten.
        allow update: if ownsCareer(uid) && request.resource.data == resource.data;
        allow delete: if false;
      }
    }
    match /onlineMatches/{code} {
      function signedIn() {
        return request.auth != null;
      }
      function participant(data) {
        return signedIn() && (request.auth.uid == data.hostUid || request.auth.uid == data.guestUid);
      }
      function validTurnUpdate() {
        return participant(resource.data)
          && resource.data.status == 'active'
          && resource.data.turnUid == request.auth.uid
          && request.resource.data.hostUid == resource.data.hostUid
          && request.resource.data.guestUid == resource.data.guestUid
          && request.resource.data.revision == resource.data.revision + 1
          && request.resource.data.status in ['active', 'finished', 'abandoned']
          && request.resource.data.turnUid in ['', resource.data.hostUid, resource.data.guestUid]
          && request.resource.data.minute is int
          && request.resource.data.minute >= resource.data.minute
          && request.resource.data.minute <= 120
          && request.resource.data.scoreHome is int
          && request.resource.data.scoreHome >= 0
          && request.resource.data.scoreAway is int
          && request.resource.data.scoreAway >= 0
          && request.resource.data.events is list
          && request.resource.data.events.size() <= 150
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'home', 'away', 'minute', 'phase', 'scoreHome', 'scoreAway',
            'homeTactic', 'awayTactic', 'events', 'status', 'turnUid',
            'revision', 'updatedAt'
          ]);
      }
      allow get: if signedIn()
        && (resource.data.status == 'waiting' || participant(resource.data));
      allow list: if false;
      allow create: if signedIn()
        && request.auth.uid == request.resource.data.hostUid
        && code == request.resource.data.code
        && code.matches('^[0-9A-F]{6}$')
        && request.resource.data.guestUid == ''
        && request.resource.data.status == 'waiting'
        && request.resource.data.home is map
        && request.resource.data.home.players is list
        && request.resource.data.home.players.size() == 11
        && request.resource.data.events is list
        && request.resource.data.events.size() <= 150
        && request.resource.data.revision == 0
        && request.resource.data.keys().hasOnly([
          'code', 'hostUid', 'guestUid', 'hostName', 'guestName', 'home', 'away',
          'status', 'turnUid', 'minute', 'phase', 'scoreHome', 'scoreAway',
          'homeTactic', 'awayTactic', 'events', 'revision', 'createdAt', 'updatedAt'
        ]);
      allow update: if signedIn() && (
        (resource.data.status == 'waiting'
          && resource.data.guestUid == ''
          && request.auth.uid != resource.data.hostUid
          && request.resource.data.guestUid == request.auth.uid
          && request.resource.data.status == 'active'
          && request.resource.data.turnUid == resource.data.hostUid
          && request.resource.data.away is map
          && request.resource.data.away.players is list
          && request.resource.data.away.players.size() == 11
          && request.resource.data.revision == resource.data.revision + 1
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'guestUid', 'guestName', 'away', 'status', 'turnUid', 'events', 'revision', 'updatedAt'
          ]))
        || validTurnUpdate()
      );
      allow delete: if false;
    }
  }
}
